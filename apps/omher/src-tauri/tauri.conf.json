{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Awaken Bot",
  "version": "0.1.0",
  "identifier": "com.awakenbot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5207",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Awaken Bot",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../bridge/omher_bridge.py": "bridge/omher_bridge.py"
    },
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Your bots. One calm workspace.",
    "copyright": "MIT License, oh-my-hermes contributors",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxNDY3MjVCRDk1Q0I0RDAKUldUUXRGelpXM0pHQVczZ1g2N3UveGl6N0RGQmp3bVdhY1R1cExMVzFXVDFVQkRuOC85UUd5TjcK",
      "endpoints": [
        "https://github.com/rubengarciajr/oh-my-awakenbot/releases/download/awakenbot-latest/latest.json"
      ]
    }
  }
}
